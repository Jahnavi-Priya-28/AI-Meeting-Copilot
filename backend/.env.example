# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...your_openai_key_here...
OPENAI_MODEL=gpt-4o-mini          # Swap to gpt-4o for higher quality

# ── Google Cloud Translate ─────────────────────────────────────────────────────
# Option A: Service account JSON path (recommended for production)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Option B: Direct API key (simpler for dev)
GOOGLE_TRANSLATE_API_KEY=...your_google_api_key_here...
GOOGLE_PROJECT_ID=your-gcp-project-id

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=meeting_copilot

# ── Whisper ────────────────────────────────────────────────────────────────────
# Options: tiny, base, small, medium, large  (larger = slower but more accurate)
WHISPER_MODEL_SIZE=base

# ── File Upload ────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=100

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development               # development | production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
